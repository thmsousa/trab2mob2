<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homepageFragmentm">

    <fragment
        android:id="@+id/homepageFragmentm"
        android:name="com.example.trabalho2_150926.View.fragments.HomepageFragment"
        android:label="Boas-Vindas" />

    <fragment
        android:id="@+id/listaAlunosFragment"
        android:name="com.example.trabalho2_150926.View.fragments.ListaAlunosFragment"
        android:label="Listagem de Alunos">
        <action
            android:id="@+id/action_lista_to_editar"
            app:destination="@id/editarAlunoFragment" />
        <action
            android:id="@+id/action_lista_to_detalhes"
            app:destination="@id/detalhesAlunoFragment" />
